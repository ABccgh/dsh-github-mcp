# Dependencies
node_modules/
.pnpm-store/

# Secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key

# DeepSeek Harness local state
.credentials.yaml
.dsh/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local install scratch. The install target must never live inside a checkout:
# a link: dependency on a working tree puts the live config — token included —
# one `git add -A` away from being committed.
.install/
dsh-bundles/

# Token-bearing patch copies. The committed patch
# (dsh-github-mcp/cordis.patch.yml) is a token-free template; the install copy's
# ./cordis.patch.yml and ./cordis.patch.literal.yml carry the real token, so
# neither filename may ever surface at this repository's root.
/cordis.patch.yml
/cordis.patch.literal.yml
cordis.patch.local.yml
*.secret.yml
